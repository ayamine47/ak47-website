---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { flex, hstack, vstack } from '../../styled-system/patterns';

interface Props {
  title: string;
  href: string;
  image: ImageMetadata;
  alt_text: string;
  date: string;
  tags: string[];
  description: string;
}

const { title, href, image, alt_text, date, tags, description } = Astro.props;
---

<div class={css({ m: '4' })}>
  <a href={href}>
    <div class={flex({
      w: '100%',
      minH: '180',
      maxH: '240',
      p: '1',
      columnGap: { base: '2', md: '8' },
      border: '1',
      borderColor: 'white',
      borderStyle: 'solid'
    })}>
      <Image
        src={image}
        alt={alt_text}
        class={css({
          width: { base: '20', md: '120' },
          objectFit: 'contain'
        })}
      />
      <div class={vstack({
        alignItems: 'start',
        justify: 'center',
        rowGap: '1'
      })}>
        <p class={css({fontSize: "xs"})}>{date}</p>
        <p class={css({fontSize: "xl" })}>{title}</p>
        <p class={css({
          fontSize: "sm",
          whiteSpace: 'pre-line'
        })}>
          {description}
        </p>
        <div class={hstack({ gap: '2', my: '2' })}>
          {
            tags.map((tag) => (
              <button class={css({
                p: '1',
                border: '1',
                borderStyle: 'solid',
                fontSize: "sm",
              })}>
                #{tag}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </a>
</div>