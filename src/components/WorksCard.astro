---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { flex, hstack, vstack } from '../../styled-system/patterns';

interface Props {
  title: string;
  href: string;
  image?: ImageMetadata;
  alt_text: string;
  date: string;
  tags?: string[];
  description: string;
}

const { title, href, image, alt_text, date, tags, description } = Astro.props;
---

<div class={css({ m: '4' })}>
  <a href={href}>
    <div class={css({
      bg: "black",
      w: 'full',
      border: '1',
      borderColor: '#72b6e3',
      borderStyle: 'solid',
      _hover: {
        bg: "zinc.900"
      }
    })}>
      <div class={flex({
        direction: { base: "column", md: "row" },
        align: "center",
        p: '4',
        gap: '4',
      })}>
        {
          image &&
          <div class={css({ w: '24' })}>
            <Image
              src={image}
              alt={alt_text}
            />
          </div>
        }
        <div class={vstack({
          alignItems: 'start',
          justify: 'center',
          rowGap: '1'
        })}>
          <p class={css({fontSize: { base: 'sm', md: 'md' }, fontFamily: 'oranienbaum', color: 'zinc.400' })}>{date}</p>
          <p class={css({fontSize: "xl" })}>{title}</p>
          <p class={css({
            fontSize: "sm",
            whiteSpace: 'pre-line'
          })}>
            {description}
          </p>
        </div>
      </div>
      {
        tags &&
        <div class={hstack({ gap: '2', my: '4', px: '4' })}>
          {
            tags.map((tag) => (
              <button class={css({
                p: '1',
                border: '1',
                borderStyle: 'solid',
                borderColor: '#72b6e3',
                fontSize: "sm",
              })}>
                #{tag}
              </button>
            ))
          }
        </div>
      }
    </div>
  </a>
</div>