---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Content from '../components/Content.astro';

import ak47_icon from '../assets/ak47_icon.png';
---

<BaseLayout pageTitle="Profile">
  <Section heading='Profile'>
      <Image
        src={ak47_icon}
        alt="AK47's icon"
        class={css({
            alignSelf: 'center'
        })}
      />
      <p class={css({
        fontSize: '64',
        alignSelf: 'center',
      })}>
        AK47
      </p>

     <Content text='名義'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>AK47&emsp;&ensp; : 以下の名義の同一性を保持するための名義</li>
          <li>紅坂篤樹 : 文芸・論考・批評</li>
          <li>彩峰冬総 : 音楽</li>
          <li>彩峰黎斗 : エンジニアリング</li>
          <!-- <li>ミギー&emsp; : まあ、そう呼ばれる時もありますよね</li> -->
        </div>
     </Content>
      
     <Content text='学歴'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>25.04 -【現在】 <a href="https://www.jinbun.tsukuba.ac.jp"><u>筑波大学 人文・文化学群 人文学類</u></a></li>
          <li>22.04 - 25.03 &emsp;<a href="https://www.metro.ed.jp/tamakagakugijutsu-h"><u>東京都立多摩科学技術高等学校</u></a></li>
        </div>
     </Content>

     <Content text='資格'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>JAA アロマコーディネーター</li>
          <li>第三級アマチュア無線技士</li>
        </div>
     </Content>

     <Content text='所属組織'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>25.07 -【現在】 <a href="https://word-ac.net"><u>WORD 編集部</u></li></a>
          <li>25.05 -【現在】 <a href="https://www.wide.ad.jp"><u>WIDE Project</u></li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://jr1ztt.net"><u>筑波大学電気通信研究会</u></li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://www.stb.tsukuba.ac.jp/~tabi"><u>筑波大学旅と鉄道の会</u></li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://gsk-tsukuba.net"><u>筑波大学現代視覚文化研究会</u></li></a>
          <li>25.03 -【現在】 <a href="https://ut-vinos.netlify.app"><u>東大ビジュアルノベル同好会</u></a></li>
          <li>25.01 -【現在】 <a href="https://twitter.com/KUVNLovers"><u>京大美少女ゲーム同好会 (25.05 -【現職】副会長)</u></a></li>
          <li>22.09 - 25.03 &emsp;多摩科技無線工作部 (22.12 - 23.12 副部長)</li>
          <li>22.04 - 25.03 &emsp;<a href="https://twitter.com/tamakagi_pc"><u>多摩科技パソコン部 (23.02 - 23.12 総務)</u></a></li>
        </div>
     </Content>

     <Content text='興味・関心'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>哲学 (深層心理学・心身問題・科学哲学・存在論・認識論)</li>
          <li>宗教学 (キリスト教神学・インド哲学・仏教学)</li>
          <li>数学 (圏論・計算機数学・数理論理学・数学基礎論)</li>
          <li>物理学 (宇宙物理学)</li>
          <li>情報学 (ネットワークインフラ・セキュリティ)</li>
        </div>
     </Content>

     <Content text='趣味'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>クラシックピアノ</li>
        </div>
     </Content>

     <Content text='好きな人物'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: '12', md: '24' } })}>
          <li>特撮</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>『海賊戦隊ゴーカイジャー』バスコ = ダ = ジョロキア</li>
            <li>『仮面ライダー 555』海堂直也</li>
            <li>『仮面ライダーエグゼイド』檀黎斗</li>
          </div>
          <li>アニメ・ゲーム</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>『学園アイドルマスター』雨夜　燕</li>
            <li>『ステーションメモリーズ！』諸星すばる</li>
            <li>『WHITE ALBUM 2』冬馬かずさ</li>
            <li>『魔法少女まどか☆マギカ』美樹さやか</li>
            <li>『冴えない彼女の育てかた』霞ヶ丘詩羽</li>
            <li>『この素晴らしい世界に祝福を！』<br>ダスティネス = フォード = ララティーナ</li>
          </div>
        </div>
     </Content>
  </Section>
</BaseLayout>