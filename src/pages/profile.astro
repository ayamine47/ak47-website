---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Content from '../components/Content.astro';

import ak47_icon from '../assets/ak47_icon.png';
---

<BaseLayout pageTitle="Profile">
  <Section heading='Profile'>
      <Image
        src={ak47_icon}
        alt="AK47's icon"
        class={css({
            alignSelf: 'center'
        })}
      />
      <p class={css({
        fontSize: "6xl",
        fontFamily: 'oranienbaum',
        alignSelf: 'center',
      })}>
        AK47
      </p>

     <Content text='名義'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>AK47&emsp;&ensp; : 以下の名義の同一性を保持するための名義</li>
          <li><a href="/katsuki" class={css({ color: '#72b6e3' })}>紅坂篤樹 : 文芸・論考・批評</a></li>
          <li><a href="/kazusa" class={css({ color: '#72b6e3' })}>彩峰冬総 : 音楽</a></li>
          <li><a href="/kuroto" class={css({ color: '#72b6e3' })}>彩峰黎斗 : エンジニアリング</a></li>
          <li>彩峰鋼一 : 演出・映像</li>
          <li>彩峰慶次 : プロデュース</li>
          <!-- <li>ミギー&emsp; : まあ、そう呼ばれる時もありますよね</li> -->
        </div>
     </Content>
      
     <Content text='学歴'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>25.04 -【現在】 <a href="https://www.jinbun.tsukuba.ac.jp" class={css({ color: '#72b6e3' })}>筑波大学 人文・文化学群 人文学類</a></li>
          <li>22.04 - 25.03 &emsp;<a href="https://www.metro.ed.jp/tamakagakugijutsu-h" class={css({ color: '#72b6e3' })}>東京都立多摩科学技術高等学校</a></li>
        </div>
     </Content>

     <Content text='自然言語'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>日本語 (母語)</li>
          <li>英　語</li>
          <li>フランス語 : かなり講読できる</li>
          <li>サンスクリット : かなり講読できる</li>
          <li>ドイツ語 : 結構講読できる</li>
          <li>チベット語 : 結構講読できる</li>
          <li>聖書ヘブライ語 : 少し講読できる</li>
          <li>古典ギリシャ語 : かじった</li>
          <li>ラテン語 : かじった</li>
          <li>古英語 : かじった</li>
        </div>
     </Content>

     <Content text='資格'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>JAA アロマコーディネーター</li>
          <li>第三級アマチュア無線技士</li>
        </div>
     </Content>

     <Content text='所属組織'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>25.07 -【現在】 <a href="https://word-ac.net" class={css({ color: '#72b6e3' })}>WORD 編集部</li></a>
          <li>25.05 -【現在】 <a href="https://www.wide.ad.jp" class={css({ color: '#72b6e3' })}>WIDE Project</li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://jr1ztt.net" class={css({ color: '#72b6e3' })}>筑波大学電気通信研究会</li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://www.stb.tsukuba.ac.jp/~tabi" class={css({ color: '#72b6e3' })}>筑波大学旅と鉄道の会</li></a>
          <li>同&emsp;&ensp; -【現在】 <a href="https://gsk-tsukuba.net" class={css({ color: '#72b6e3' })}>筑波大学現代視覚文化研究会</li></a>
          <li>25.01 -【現在】 <a href="https://twitter.com/KUVNLovers" class={css({ color: '#72b6e3' })}>京大美少女ゲーム同好会 (25.05 -【現職】副会長)</a></li>
          <li>22.09 - 25.03 &emsp;多摩科技無線工作部 (22.12 - 23.12 副部長)</li>
          <li>22.04 - 25.03 &emsp;<a href="https://twitter.com/tamakagi_pc" class={css({ color: '#72b6e3' })}>多摩科技パソコン部 (23.02 - 23.12 総務)</a></li>
        </div>
     </Content>

     <Content text='興味・関心'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>インド論理学 (ニヤーヤ、仏教論理学)</li>
          <li>仏教学 (唯識)</li>
          <li>ユング心理学</li>
          <li>中世スコラ神学 (アウグスティヌス、トマス・アクィナス、エックハルト)</li>
          <li>数学 (圏論、数理論理学)</li>
          <li>情報学 (ネットワークインフラ、セキュリティ)</li>
        </div>
     </Content>

     <Content text='趣味'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>創作 (文芸、音楽)</li>
          <li>プログラミング</li>
          <li>神社・寺院見学</li>
          <li>旅行、乗り鉄</li>
          <li>クラシックピアノ</li>
          <li>特撮</li>
          <li>美少女ゲーム</li>
          <li>ネットワークインフラ構築、運用</li>
          <li>アマチュア無線コンテスト</li>
        </div>
     </Content>

     <Content text='苦手なもの'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>現代社会</li>
          <li>女性声優</li>
          <li>P ドル</li>
        </div>
     </Content>

     <Content text='好きな人物'>
        <div class={css({ pl: { base: '6', md: '8' }, fontSize: { base: "sm", md: "md" } })}>
          <li>エンターテイナー</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>三浦大知</li>
          </div>
          <li>声優</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>茅野愛衣</li>
            <li>遠野そよぎ</li>
          </div>
          <li>脚本家</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>井上敏樹</li>
            <li>虚淵玄</li>
            <li>小林靖子</li>
            <li>高橋悠也</li>
            <li>吉宗鋼紀</li>
          </div>
          <li>アニメ・ゲーム</li>
          <div class={css({ pl: { base: '6', md: '8' } })}>
            <li>『アイドルマスター　シャイニーカラーズ』幽谷霧子</li>
            <li>『学園アイドルマスター』雨夜　燕</li>
            <li>『この素晴らしい世界に祝福を！』ダスティネス・フォード・ララティーナ</li>
            <li>『冴えない彼女の育てかた』霞ヶ丘詩羽</li>
            <li>『ステーションメモリーズ！』諸星すばる</li>
            <li>『スーパーダンガンロンパ 2　さよなら絶望学園』小泉真昼、罪木蜜柑</li>
            <li>『ダンガンロンパ　希望の学園と絶望の高校生』戦刃むくろ</li>
            <li>『FINAL FANTASY VI』セリス・シェール、他ロック以外の皆</li>
            <li>『星のカービィ』メタナイト</li>
            <li>『WHITE ALBUM 2』冬馬かずさ</li>
            <li>『マブラヴ』彩峰慧、柏木晴子、煌武院悠陽</li>
            <li>『魔法少女まどか☆マギカ』美樹さやか</li>
          </div>
        </div>
     </Content>
  </Section>
</BaseLayout>