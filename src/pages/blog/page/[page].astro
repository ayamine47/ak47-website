---
import { getCollection } from 'astro:content';

import '../../../styles/global.css';
import { css } from '../../../../styled-system/css';
import { flex, vstack } from '../../../../styled-system/patterns';

import BaseLayout from '../../../layouts/BaseLayout.astro';

import Section from '../../../components/Section.astro';
import WorksCard from '../../../components/WorksCard.astro';

import dummy from '../../../assets/dummy.png';

export async function getStaticPaths() {
  const pageSize = 5;
  const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  const totalPages = Math.ceil(allPosts.length / pageSize);

  if (totalPages <= 1) {
    return [];
  }

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * pageSize;
    const end = start + pageSize;

    return {
      params: { page: String(page) },
      props: {
        currentPage: page,
        totalPages,
        pageSize,
        posts: allPosts.slice(start, end),
      },
    };
  });
}

const { currentPage, posts, totalPages, pageSize } = Astro.props;
const listSlots = Array.from({ length: pageSize }, (_, i) => posts[i] ?? null);

function stripMarkdown(markdown: string) {
    return markdown
        .replace(/```[\s\S]*?```/g, '')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/!\[.*?\]\(.*?\)/g, '')
        .replace(/\[(.*?)\]\(.*?\)/g, '$1')
        .replace(/#{1,6}\s?.*/g, '')
        .replace(/^[\s]*[-*+]\s+/gm, '')
        .replace(/^>\s?/gm, '')
        .replace(/^(---|___|\*\*\*)\s*$/gm, '')
        .replace(/(\*\*|__|~~|\*|_)/g, '')
        .replace(/\r?\n/g, " ")
        .replace(/\s+/g, ' ')
        .trim();
}

function truncateDescription(text: string, maxLength = 96) {
    const plain = stripMarkdown(text);
    return plain.length > maxLength ? plain.slice(0, maxLength - 2) + '……' : plain;
}
---

<BaseLayout pageTitle={`ブログ記事一覧`}>
  <Section heading='Blog'>
    <div class={vstack({ w: 'full', gap: '4', p: '0' })}>
			{
				listSlots.map((post) => (
					<div class={css({ w: 'full' })}>
						{
							post ? (
								<WorksCard
									title={post.data.title}
									href={`/blog/${post.id}`}
									image={dummy}
									alt_text='Dummy Image'
									date={post.data.date}
									tags={[]}
									description={truncateDescription(post.body || '')}
								/>
							) : (
								<div aria-hidden='true' class={css({ minH: '80px' })}></div>
							)
						}
					</div>
				))
			}
    </div>

    <nav aria-label='Blog Pagination' class={flex({ gap: '2', alignSelf: 'center', minH: '8' })}>
      {
        Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
          page === currentPage ? (
            <span class={css({ px: '4', py: '2', border: '1', borderColor: 'white', borderStyle: 'solid', bg: 'white', color: 'black' })}>{page}</span>
          ) : page === 1 ? (
            <a href={`/blog`} class={css({ px: '4', py: '2', border: '1', borderColor: 'white', borderStyle: 'solid', bg: 'black', color: 'white' })}>1</a>
          ) : (
            <a href={`/blog/page/${page}`} class={css({ px: '4', py: '2', border: '1', borderColor: 'white', borderStyle: 'solid', bg: 'black', color: 'white' })}>{page}</a>
          )
        )
      }
    </nav>
  </Section>
</BaseLayout>