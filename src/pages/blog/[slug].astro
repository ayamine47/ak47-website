---
import { getCollection, render } from 'astro:content';

import "../../styles/blog.css";

import { css } from '../../../styled-system/css';
import { flex } from '../../../styled-system/patterns';

import Heading from '../../components/Heading.astro';

import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const textLen = post.body ? post.body.length : 0;
const read_time = Math.ceil(textLen / 500);

function stripMarkdown(markdown: string) {
    return markdown
        .replace(/```[\s\S]*?```/g, '')
        .replace(/`([^`]+)`/g, '$1')
        .replace(/!\[.*?\]\(.*?\)/g, '')
        .replace(/\[(.*?)\]\(.*?\)/g, '$1')
        .replace(/#{1,6}\s?.*/g, '')
        .replace(/^[\s]*[-*+]\s+/gm, '')
        .replace(/^>\s?/gm, '')
        .replace(/^(---|___|\*\*\*)\s*$/gm, '')
        .replace(/(\*\*|__|~~|\*|_)/g, '')
        .replace(/\r?\n/g, " ")
        .replace(/\s+/g, ' ')
        .trim();
}

function truncateDescription(text: string, maxLength = 80) {
    const plain = stripMarkdown(text);
    return plain.length > maxLength ? plain.slice(0, maxLength - 2) + '……' : plain;
}
---

<BlogLayout pageTitle={post.data.title} description={truncateDescription(post.body!)}>
  <main class={flex({
    w: 'full',
    direction: 'column',
    align: 'center',
    paddingBottom: '24',
  })}>
    <Heading>Blog</Heading>
    <div class={css({
      w: 'full',
      p: '8',
      bg: 'gray.800',
      border: '1',
      borderColor: 'white',
      borderStyle: 'solid',
      fontFamily: 'mplus'
    })}>
      <u class={css({ fontSize: "4xl" })}>{post.data.title}</u>
      <p class={css({ color: 'zinc.400', my: '4', fontSize: "md" })}>{post.data.date}&nbsp;・&nbsp;{read_time} 分で読めます</p>
      <div class={css({
        my: '8',
        fontSize: "md",
      })}>
        <Content />
      </div>
    </div>

    <a
      href='/blog'
      class={css({
        my: '8',
        bg: 'black',
        color: 'white',
        alignSelf: 'center',
        fontSize: "2xl",
      })}
    >
      <u>戻　る</u>
    </a>
  </main>
  </Section>
</BaseLayout>