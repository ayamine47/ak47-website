---
import { getCollection, render } from 'astro:content';

import "../../styles/blog.css";

import { css } from '../../../styled-system/css';
import { flex } from '../../../styled-system/patterns';

import Heading from '../../components/Heading.astro';

import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const textLen = post.body ? post.body.length : 0;
const read_time = Math.ceil(textLen / 500);
---

<BaseLayout pageTitle={post.data.title}>
  <main class={flex({
    w: 'full',
    direction: 'column',
    align: 'center',
    paddingBottom: '24',
  })}>
    <Heading>Blog</Heading>
    <div class={css({
      w: 'full',
      p: '8',
      bg: 'gray.800',
      border: '1',
      borderColor: 'white',
      borderStyle: 'solid',
      fontFamily: 'mplus'
    })}>
      <u class={css({ fontSize: "4xl" })}>{post.data.title}</u>
      <p class={css({ color: 'gray.400', my: '4', fontSize: "md" })}>{post.data.date}&nbsp;・&nbsp;{read_time} 分で読めます</p>
      <div class={css({
        my: '8',
        fontSize: "md",
      })}>
        <Content />
      </div>
    </div>

    <a
      href='/blog'
      class={css({
        my: '8',
        bg: 'black',
        color: 'white',
        alignSelf: 'center',
        fontSize: "2xl",
      })}
    >
      <u>戻　る</u>
    </a>
  </main>
  </Section>
</BaseLayout>