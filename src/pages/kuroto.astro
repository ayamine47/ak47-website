---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';

import Content from '../components/Content.astro';
import Section from '../components/Section.astro';
import WorksCard from '../components/WorksCard.astro';

import github from '../assets/github.png';

interface WorkMetaData {
  title: string;
  href: string;
  image: ImageMetadata;
  date: string;
  tags: string[];
  description: string;
}

const works: WorkMetaData[] = [
  // template
  /*
  {
    title: '',
    href: '',
    image: ,
    date: '',
    tags: [
      ''
    ],
    description: ''
  },
  */
  {
    title: 'mahiru',
    href: 'https://github.com/ayamine47/mahiru',
    image: github,
    date: '26.03',
    tags: [
      'AndroidApp',
      'Dart',
      'Flutter'
    ],
    description: 'NDI で LAN 内へ映像を伝送する Android アプリ\nWritten in Dart'
  },
  {
    title: 'sumika',
    href: 'https://github.com/ayamine47/sumika',
    image: github,
    date: '25.08',
    tags: [
      'DiscordBot',
      'Go',
    ],
    description: '動画を JOYSOUND で流すことのできるフォーマットへ変換するなどする DiscordBot\nWritten in Go'
  },
  {
    title: 'Bocchi-Go (Archive)',
    href: 'https://github.com/tpc3/Bocchi-Go',
    image: github,
    date: '23.03',
    tags: [
      'DiscordBot',
      'Go',
    ],
    description: 'ChatGPT を Discord 上から使用する DiscordBot\nWritten in Go'
  },
  {
    title: 'DuckPolice',
    href: 'https://github.com/tpc3/DuckPolice',
    image: github,
    date: '23.03',
    tags: [
      'DiscordBot',
      'Go'
    ],
    description: '重複した URL が投稿された場合、警告を表示する DiscordBot\nWritten in Go'
  },
];

const contributions: WorkMetaData[] = [
  {
    title: 'Bocchi-Re',
    href: 'https://github.com/tpc3/Bocchi-Re',
    image: github,
    date: '23.12',
    tags: [
      'DiscordBot',
      'Go',
    ],
    description: 'ChatGPT を Discord 上から使用する DiscordBot\nWritten in Go, Refactor of Bocchi-Go'
  }
];

---

<BaseLayout pageTitle='彩峰黎斗'>
  <Section heading='Engineering'>
      <p class={css({
        fontSize: '64',
        alignSelf: 'center',
      })}>
        彩峰黎斗
      </p>
      <p class={css({
        fontSize: '32',
        alignSelf: 'center',
      })}>
        <b>K</b>uroto <b>A</b>yamine
      </p>

      <Content text='作業環境'>
        <div class={css({ fontSize: '24' })}>
          <div class={css({pl: '8' })}>
            <li>OS: NixOS</li>
            <li>Kernel: linux-zen</li>
            <li>DE: hyprland</li>
          </div>
        </div>
      </Content>

      <Content text='好きな言語'>
        <div class={css({ fontSize: '24' })}>
          <div class={css({pl: '8' })}>
            <li>Dart</li>
            <li>Go</li>
            <li>Rust</li>
          </div>
        </div>
      </Content>

      <Content text='触ったことのある言語'>
        <div class={css({ fontSize: '24' })}>
          <div class={css({pl: '8' })}>
            <li>C++</li>
            <li>Lua</li>
            <li>Nix</li>
            <li>Python</li>
            <li>Shell Script</li>
            <li>TypeScript</li>
          </div>
        </div>
      </Content>

      <Content text='制作物一覧'>
        {
          works.map((work) => (
            <WorksCard
              title={work.title}
              href={work.href}
              image={work.image}
              alt_text={work.title}
              date={work.date}
              tags={work.tags}
              description={work.description}
            />
          ))
        }
      </Content>

    <Content text='Contribution 一覧'>
        {
          contributions.map((work) => (
            <WorksCard
              title={work.title}
              href={work.href}
              image={work.image}
              alt_text={work.title}
              date={work.date}
              tags={work.tags}
              description={work.description}
            />
          ))
        }
      </Content>
  </Section>
</BaseLayout>