---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';

import Content from '../components/Content.astro';
import Section from '../components/Section.astro';
import WorksCard from '../components/WorksCard.astro';

import hanshin from '../assets/katsuki/334.jpg';
import anima from '../assets/katsuki/anima.webp';
import chocolate from '../assets/katsuki/chocolate.jpg';
import dokuhaku from '../assets/katsuki/dokuhaku.jpg';
import hermeneutics from '../assets/katsuki/hermeneutics.png';
import ittai_itsukara_1 from '../assets/katsuki/ittai_itsukara_1.jpg';
import ittai_itsukara_2 from '../assets/katsuki/ittai_itsukara_2.jpg';
import ittai_itsukara_3 from '../assets/katsuki/ittai_itsukara_3.jpg';
import jasmine from '../assets/katsuki/jasmine.jpg';
import oni from '../assets/katsuki/oni.jpg';
import pad from '../assets/katsuki/pad.jpg';
import semantics from '../assets/katsuki/semantics.png';
import shitaume from '../assets/katsuki/shitaiume.jpg';
import smartphone from '../assets/katsuki/smartphone.jpg';
import star from '../assets/katsuki/star.jpg';
import sumika_date from '../assets/katsuki/sumika_date.jpg';
import the_entertainer from '../assets/katsuki/the_entertainer.jpg';

interface WorkMetaData {
  title: string;
  href: string;
  image: ImageMetadata;
  date: string;
  tags: string[];
  description: string;
}

const works: WorkMetaData[] = [
  // template
  /*
  {
    title: '',
    href: '',
    image: ,
    date: '',
    tags: [
      ''
    ],
    description: ''
  },
  */
  {
    title: '燕「プロデューサーのスマフォ……？」',
    href: 'https://www.pixiv.net/novel/show.php?id=28389456',
    image: smartphone,
    date: '26.06.20',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: 'プロデューサーのスマートフォンを覗き見る燕。\nしかし、彼女が見たものは、予想だにしないもので――'
  },
  {
    title: '清夏「P っち、デートしよ！」',
    href: 'https://www.pixiv.net/novel/show.php?id=28278890',
    image: sumika_date,
    date: '26.06.07',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: 'プロデューサーは、紫雲清夏とデートをする。\n素直になり切れない二人の、甘酸っぱい物語が辿る結末とは――'
  },
  {
    title: '一体いつから・第 3 話',
    href: 'https://www.pixiv.net/novel/show.php?id=28244743',
    image: ittai_itsukara_3,
    date: '26.06.03',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '『一体いつから』の歌詞をめぐり、いよいよ雨夜燕と月村手毬の対話が始まる。\n手毬が辿り着く、一つの結論とは――'
  },
  {
    title: '一体いつから・第 2 話',
    href: 'https://www.pixiv.net/novel/show.php?id=28235657',
    image: ittai_itsukara_2,
    date: '26.06.02',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '月夜野での仕事を終え、宿へ着いた燕のプロデューサーは、手毬のプロデューサーと合流する。\nそこで聞かされた手毬の新曲『一体いつから』がもつメッセージの、彼らなりの解釈とは。'
  },
  {
    title: '一体いつから・第 1 話',
    href: 'https://www.pixiv.net/novel/show.php?id=28208993',
    image: ittai_itsukara_1,
    date: '26.05.30',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '群馬県・水上の月夜野で仕事をすることになった、月村手毬と雨夜燕の物語。'
  },
  {
    title: '配信と背信、穢れし茉莉花《ジャスミン》',
    href: 'https://www.pixiv.net/novel/show.php?id=28184789',
    image: jasmine,
    date: '26.05.27',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: 'ある炎上事件に巻き込まれてしまった姫崎莉波。\n彼女のプロデューサーは、誰もいない茶室で、何を語るのか――'
  },
  {
    title: 'The Entertainer',
    href: 'https://www.pixiv.net/novel/show.php?id=28124750',
    image: the_entertainer,
    date: '26.05.20',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '生誕ライブを終えた雨夜燕とそのプロデューサーは、秩父へ遠足をしに行く。\nそこで語られる、燕の在るべき姿とは――'
  },
  {
    title: '「雨夜さん、胸盛ってませんか？」',
    href: 'https://www.pixiv.net/novel/show.php?id=28119870',
    image: pad,
    date: '26.05.20',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '雨夜燕のプロデューサーは、彼女の『Campus Mode!!』衣装を見て疑念を抱く――\nパッドなのではないか、と。'
  },
  {
    title: '三分三十四秒の創世',
    href: 'https://www.pixiv.net/novel/show.php?id=28104804',
    image: hanshin,
    date: '26.05.18',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '「4 秒足りない！」雨夜燕のプロデューサーはそう言った。'
  },
  {
    title: '独白',
    href: 'https://www.pixiv.net/novel/show.php?id=27873656',
    image: dokuhaku,
    date: '26.04.21',
    tags: [
      '物語的文章',
      '学園アイドルマスター',
    ],
    description: '雨夜燕のプロデューサー。\n彼はどのようにして、雨夜燕を裏切ったのか――'
  },
  {
    title: '美少女ゲームというテクストの意義―アニマの知覚―',
    href: 'https://kuvnlovers.hatenablog.com/entry/bishojo-game-anima',
    image: anima,
    date: '26.04.07',
    tags: [
      '説明的文章',
      '現代視覚文化論',
      '京大美少女ゲーム同好会'
    ],
    description: '美少女ゲームのもつ意義について、ユング心理学の観点から解説する。'
  },
  {
    title: '美少女ゲーム解釈学入門',
    href: 'https://kuvnlovers.hatenablog.com/entry/bishojo-game-semantics',
    image: hermeneutics,
    date: '26.04.04',
    tags: [
      '説明的文章',
      '現代視覚文化論',
      '京大美少女ゲーム同好会'
    ],
    description: '美少女ゲームを " 解釈 " する行為について解説する。'
  },
  {
    title: '美少女ゲームという言葉を再定義する',
    href: 'https://kuvnlovers.hatenablog.com/entry/bishojo-game-semantics',
    image: semantics,
    date: '26.03.30',
    tags: [
      '説明的文章',
      '現代視覚文化論',
      '京大美少女ゲーム同好会'
    ],
    description: '美少女ゲームという言葉について、定義を再検討する。'
  },
  {
    title: '死体を埋める雨夜さん',
    href: 'https://www.pixiv.net/novel/show.php?id=27475886',
    image: shitaume,
    date: '26.03.08',
    tags: [
      '物語的文章',
      '学園アイドルマスター'
    ],
    description: '人を殺してしまった、雨夜燕のプロデューサー。\nその事実を耳にした雨夜燕は――'
  },
  {
    title: 'そんなにチョコレートが欲しいなら、くれてやっても良い',
    href: 'https://www.pixiv.net/novel/show.php?id=27282800',
    image: chocolate,
    date: '26.02.14',
    tags: [
      '物語的文章',
      '学園アイドルマスター'
    ],
    description: 'プロデューサーにバレンタインの贈り物をしようとした雨夜燕。\nしかし、いつもの教室で彼女が目にしたものは――'
  },
  {
    title: '「鬼の面が取れん！」',
    href: 'https://www.pixiv.net/novel/show.php?id=27180373',
    image: oni,
    date: '26.02.02',
    tags: [
      '物語的文章',
      '学園アイドルマスター'
    ],
    description: '節分で、鬼に扮装した雨夜燕。\nしかし、お面が取れなくなってしまい――'
  },
  {
    title: '「雨夜さん、星を観に行きましょう」',
    href: 'https://www.pixiv.net/novel/show.php?id=27043993',
    image: star,
    date: '26.01.19',
    tags: [
      '物語的文章',
      '学園アイドルマスター'
    ],
    description: '八ヶ岳へ旅行をする雨夜燕。\n彼女がそこで星南に告白する、ある重大な事実は――'
  }
];

---

<BaseLayout pageTitle='紅坂篤樹'>
  <Section heading='Literature'>
      <p class={css({
        fontSize: '64',
        alignSelf: 'center',
      })}>
        紅坂篤樹
      </p>
      <p class={css({
        fontSize: '32',
        alignSelf: 'center',
      })}>
        <b>A</b>tsuki <b>K</b>osaka
      </p>

      <Content text='執筆するもの'>
        <div class={css({ fontSize: '24' })}>
          <div class={css({ pl: '8' })}>
            <li>説明的文章</li>
            <div class={css({ pl: '8' })}>
              <li>現代視覚文化論</li>
            </div>
            <li>物語的文章</li>
            <div class={css({ pl: '8' })}>
              <li>一次創作</li>
              <div class={css({ pl: '8' })}>
                <li>戯曲</li>
                <li>純文学小説</li>
                <li>マーダーミステリー</li>
              </div>
              <li>二次創作 (小説)</li>
              <div class={css({ pl: '8' })}>
                <li>学園アイドルマスター</li>
                <li>ダンガンロンパ</li>
              </div>
            </div>
          </div>
        </div>
      </Content>

      <Content text='執筆物一覧'>
        {
          works.map((work) => (
            <WorksCard
              title={work.title}
              href={work.href}
              image={work.image}
              alt_text={work.title}
              date={work.date}
              tags={work.tags}
              description={work.description}
            />
          ))
        }
      </Content>
  </Section>
</BaseLayout>