---
import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';

import Content from '../components/Content.astro';
import Section from '../components/Section.astro';
import WorksCard from '../components/WorksCard.astro';

import cry_and_night from '../assets/kazusa/cry_and_night.png';
import dawn_and_fly from '../assets/kazusa/dawn_and_fly.webp';
import dummy from '../assets/dummy.png';

interface WorkMetaData {
  title: string;
  href: string;
  image: ImageMetadata;
  date: string;
  tags: string[];
  description: string;
}

const works: WorkMetaData[] = [
  // template
  /*
  {
    title: '',
    href: '',
    image: ,
    date: '',
    tags: [
      ''
    ],
    description: ''
  },
  */
  {
    title: 'Cry & Night',
    href: 'https://anima-kristall.booth.pm/items/8940742',
    image: cry_and_night,
    date: '26.09.20',
    tags: [
      '宮舞モカ',
      '雨夜燕',
      'アイマスオリジナル曲'
    ],
    description: '雨夜燕コンセプチュアル EP『Cry & Night』700 円\nEP 本体に加え、ハイレゾ音源 (96 kHz / 24 bit) と楽曲コミュ (3 万字) つき！'
  },
  {
    title: '黎明翔破',
    href: 'https://www.nicovideo.jp/watch/sm46521091',
    image: dawn_and_fly,
    date: '26.07.07',
    tags: [
      'メタル',
      '宮舞モカ',
      '雨夜燕',
      'アイマスオリジナル曲',
    ],
    description: '雨夜燕妄想イメージソング\n筑波大学現代視覚文化研究会ボカロ班『文サ館 1 号棟』収録作品'
  },
  {
    title: '月と毒',
    href: 'https://soundcloud.com/orf6qsrzckuu/qtslgt55udgl',
    image: dummy,
    date: '26.04.25',
    tags: [
      'ゴシックメタル',
      '宮舞モカ'
    ],
    description: '筑波大学現代視覚文化研究会ボカロ班『Metalloid』収録作品'
  },
]
---

<BaseLayout pageTitle='彩峰冬総'>
  <Section heading='Music'>
      <p class={css({
        fontSize: "6xl",
        alignSelf: 'center',
      })}>
        彩峰冬総
      </p>
      <p class={css({
        fontSize: "4xl",
        alignSelf: 'center',
      })}>
        <b>K</b>azusa <b>A</b>yamine
      </p>

      <Content text='作業環境'>
        <div class={css({pl: { base: '6', md: '8' } })}>
          <li>DAW : Studio One 7 Pro</li>
          <li>シンセサイザー : KORG X50</li>
          <li>オーディオインタフェース : Presonus AudioBox iTwo</li>
        </div>
      </Content>

      <Content text='楽曲一覧'>
        {
          works.map((work) => (
            <WorksCard
              title={work.title}
              href={work.href}
              image={work.image}
              alt_text={work.title}
              date={work.date}
              tags={work.tags}
              description={work.description}
            />
          ))
        }
      </Content>
  </Section>
</BaseLayout>