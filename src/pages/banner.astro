---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';

import BaseLayout from '../layouts/BaseLayout.astro';
import Content from '../components/Content.astro';
import Section from '../components/Section.astro';
---

<BaseLayout pageTitle="Banner">
  <Section heading='Banner'>
    <Content text='バナー'>
      <p>当サイトはリンクフリーです。<br>以下のコードおよびバナーをお使いください。</p>
        
      <div class={css({
        my: '4',
        p: '4',
        border: '1',
        borderColor: 'white',
        borderStyle: 'solid',
      })}>
        <code class={css({
          fontSize: { base: '10', md: '12' },
          whiteSpace: 'pre-line'
        })}>
          {"<a href='https://www.ak47.work'>\n<img src='https://www.ak47.work/assets/banner/ak47_banner.png'\nalt='AK47 の個人サイト'>\n</a>"}
        </code>
      </div>
    
      <p>画像サイズ : 200 × 40</p>
      <Image src={'https://www.ak47.work/assets/banner/ak47_banner.png'} width={200} height={40} alt='AK47 の個人サイト' />
    </Content>
  </Section>
</BaseLayout>