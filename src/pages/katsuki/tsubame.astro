                class="novel-work-item"
                data-date={work.date}
                data-series={work.series ?? ''}
                data-series-number={work.series_number ?? 999}
                data-tags={JSON.stringify(work.tags)}
              >
                <NovelWorksCard
                  id={work.title}
                  title={work.title}
