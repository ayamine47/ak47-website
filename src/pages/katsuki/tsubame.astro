const characterTagCounts = novel_works.reduce((acc, work) => {
  work.tags.forEach((tag) => {
    if (tag && tag !== '物語的文章' && tag !== '説明的文章') {
      acc[tag] = (acc[tag] || 0) + 1;
    }
  });
  return acc;
}, {} as Record<string, number>);

const sortedCharacterTags = Object.entries(characterTagCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);

---

<BaseLayout pageTitle='特集：雨夜燕'>
  <Section heading='Literature'>
      <p class={css({
        fontSize: "6xl",
        alignSelf: 'center',
      })}>
        特集：雨夜燕
      </p>
      <p class={css({
        fontSize: "4xl",
        fontFamily: 'oranienbaum',
        alignSelf: 'center',
      })}>
        <b>T</b>subame <b>A</b>maya
      </p>

      <Content text='小説シリーズ一覧'>
        {
          novel_series.map((work) => (
            <WorksCard
              title={work.title}
              href={work.href}
