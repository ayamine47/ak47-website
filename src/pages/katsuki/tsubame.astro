</BaseLayout>

<script>
  const container = document.getElementById('novel-works-container');
  const sortButtons = document.querySelectorAll('.sort-btn');
  const tagCheckboxes = document.querySelectorAll('.tag-checkbox') as NodeListOf<HTMLInputElement>;

  if (container) {
    const items = Array.from(container.querySelectorAll('.novel-work-item')) as HTMLElement[];
    let currentSort = 'date-desc';

    const parseDate = (dateStr: string) => {
      const parts = dateStr.split('.').map((p) => p.trim());
      if (parts.length === 3) {
        return new Date(2000 + parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10)).getTime();
      }
      return 0;
    };

    const updateView = () => {
      const selectedTags = Array.from(tagCheckboxes)
        .filter((cb) => cb.checked)
        .map((cb) => cb.value);

      // 1. フィルタリング (表示・非表示)
      items.forEach((item) => {
        const tags = JSON.parse(item.dataset.tags || '[]');
        const matchesTag = selectedTags.length === 0 || selectedTags.every((t) => tags.includes(t));
        if (matchesTag) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });

      // 2. ソート適用
      const visibleItems = items.filter((item) => item.style.display !== 'none');
      visibleItems.sort((a, b) => {
        const dateA = parseDate(a.dataset.date || '');
        const dateB = parseDate(b.dataset.date || '');
        const seriesA = a.dataset.series || '';
        const seriesB = b.dataset.series || '';
        const numA = parseInt(a.dataset.seriesNumber || '999', 10);
        const numB = parseInt(b.dataset.seriesNumber || '999', 10);

        switch (currentSort) {
          case 'date-desc':
            return dateB - dateA;
          case 'date-asc':
            return dateA - dateB;
          case 'series-asc':
            if (seriesA && !seriesB) return -1;
            if (!seriesA && seriesB) return 1;
            if (seriesA !== seriesB) return seriesA.localeCompare(seriesB, 'ja');
            return numA - numB;
          case 'series-desc':
            if (seriesA && !seriesB) return -1;
            if (!seriesA && seriesB) return 1;
            if (seriesA !== seriesB) return seriesB.localeCompare(seriesA, 'ja');
            return numB - numA;
          default:
            return 0;
        }
      });

      visibleItems.forEach((item) => container.appendChild(item));
    };

    sortButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        sortButtons.forEach((b) => {
          b.style.backgroundColor = '#6c3dd5';
          b.classList.remove('active');
        });
        target.style.backgroundColor = '#8560fe';
        target.classList.add('active');
        currentSort = target.dataset.sort || 'date-desc';
        updateView();
      });
    });

    tagCheckboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        updateView();
      });
    });
  }
</script>