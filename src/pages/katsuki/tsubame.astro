            </button>
            <button
              type="button"
              class="sort-btn"
              data-sort="series-asc"
              class:list={css({
                px: "4",
                py: "2",
                borderWidth: "1",
                borderColor: "#8560fe",
                borderStyle: "solid",
                backgroundColor: "#6c3dd5",
                fontSize: "sm",
                cursor: "pointer"
              })}
            >
              シリーズ別昇順
            </button>
            <button
              type="button"
              class="sort-btn"
              data-sort="series-desc"
              class:list={css({
                px: "4",
                py: "2",
                borderWidth: "1",
                borderColor: "#8560fe",
                borderStyle: "solid",
                backgroundColor: "#6c3dd5",
                fontSize: "sm",
                cursor: "pointer"
              })}
            >
              シリーズ別降順
            </button>
          </div>

          <div class={flex({
            justify: "center",
            align: "center",
            gap: "4",
            flexWrap: "wrap",
            mt: "2"
          })}>
            <span class={css({ fontSize: "sm", fontWeight: "bold" })}>登場人物フィルタ</span>
            <div class={grid({ columns: 3 })}>
              {
                sortedCharacterTags.map((tag) => (
                  <label class={flex({ align: "center", gap: "1.5", fontSize: "sm", cursor: "pointer" })}>
                    <input type="checkbox" class="tag-checkbox" value={tag} /> 
                    <span>{tag}</span>
                    <span class={css({ color: "white" })}>({characterTagCounts[tag]})</span>
                  </label>
                ))
              }
            </div>
          </div>
        </div>
      </div>

        <div
          id="novel-works-container"
          class={flex({
            flexWrap: "wrap",
            justify: "center",
            mt: "8",
            gap: "4"
          })}
        >
          {
            novel_works.map((work) => (
