---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { flex, vstack } from '../../styled-system/patterns';

import BaseLayout from '../layouts/BaseLayout.astro';

import ak47_icon from '../assets/ak47_icon.png';
---

<BaseLayout pageTitle="Top">
  <div class={flex({
    direction: { base: 'column', lg: 'row' },
    align: 'center',
    justify: 'space-between',
    mx: '20%',
    my: '10%'
  })}>
    <Image
        src={ak47_icon}
        alt="AK47's icon"
        class={css({ alignSelf: 'center' })}
      />
    <div class={vstack({ textAlign: 'center' })}>
      <p class={css({ fontSize: "8xl" })}>
        AK47
      </p>
      <p class={css({ fontSize: { base: "2xl", md: "4xl" } })}>
        Le Penseur<br><span class={css({ display: {base: 'block', md: 'none' } })}>/</span>Contents Developer
      </p>
      <a href='/profile'>
        <u>MORE</u>
      </a>
    </div>
  </div>
</BaseLayout>