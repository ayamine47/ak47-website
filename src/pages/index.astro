---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { flex, vstack } from '../../styled-system/patterns';

import BaseLayout from '../layouts/BaseLayout.astro';

import ak47_icon from '../assets/ak47_icon.png';
---

<BaseLayout pageTitle="Top">
  <div class={flex({
    direction: { base: 'column', lg: 'row' },
    align: 'center',
    justify: 'space-between',
    mx: '20%',
    my: '10%'
  })}>
    <Image
        src={ak47_icon}
        alt="AK47's icon"
        class={css({ alignSelf: 'center' })}
      />
    <div class={vstack({ textAlign: 'center' })}>
      <p class={css({
        color: 'white',
        fontSize: "8xl",
        fontFamily: 'oranienbaum'
      })}>
        AK47
      </p>
      <hr class={css({ w: 'full', color: '#8560fe' })}>
      <p class={css({ fontSize: { base: "2xl", md: "4xl" }, fontFamily: 'oranienbaum' })}>
        Le Penseur<br><span class={css({ display: {base: 'block', md: 'none' } })}>/</span>Contents Developer
      </p>
      <a href='/profile' class={css({
        bg: '#6c3dd5',
        px: '8',
        py: '4',
        color: '#72b6e3',
        fontSize: 'xl',
        fontFamily: 'oranienbaum'
      })}>
        MORE
      </a>
    </div>
  </div>
</BaseLayout>