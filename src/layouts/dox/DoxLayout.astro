---
import '../../styles/global.css';
import { css } from '../../../styled-system/css';

import DoxHeader from '../../components/katsuki/dox/DoxHeader.astro';
import Footer from '../../components/Footer.astro';

import ak47_logo from '../../assets/ak47_icon.png';

interface Props {
  pageTitle: string;
}

const { pageTitle } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL('/assets/ak47_og.png', Astro.url);
---

<html lang="ja">
  <head prefix="https://ogp.me/ns#">
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={ak47_logo.src} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
		<meta name="description" content="AK47 のホームページ" />
		<meta name="keyword" content="ドクス 不連続存在 Dox 小説 特撮 ヒーロー ダークヒーロー アクション サスペンス ミステリー SF ファンタジー ダークファンタジー 松涛一汐 'Kazushi Matsunami' 朝川七桜 'Nanao Asakawa' 酉島千鳥 'Chidori Torishima' 佐竹茜 'Akane Satake' 九十九美梅 'Miume Tsukumo' 八雲零南 'Reina Yakumo' 五条歩霧 'Ayumu Gojo' 長谷川叶湖 'Kanako Hasegawa'" />
		<meta name="theme-color" content="rgb(0, 192, 251)" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="AK47's HomePage" />
		<meta property="og:title" content={pageTitle + " | ドクス―不連続存在― | AK47's HomePage"} />
		<meta property="og:description" content="毎週日曜あさ 10:00 に連載中の紅坂篤樹の Web 小説『ドクス―不連続存在―』の特設ページ" />
		<meta
		  property="og:image"
		  content={socialImageURL}
		/>
		<meta property="og:image:width" content="1920" />
		<meta property="og:image:height" content="1080" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://www.ak47.work/katsuki/dox" />
		<meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ak47_work" />
    <meta name="twitter:creator" content="@ak47_work" />
    <title>{pageTitle + " | ドクス―不連続存在― | AK47's HomePage"}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+1:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Oranienbaum&display=swap" rel="stylesheet">
  </head>
  <body class={css({
    bg: '#1F2636',
    color: 'white',
    fontFamily: 'mincho',
    fontSize: { base: "sm", md: "md" },
    position: 'relative'
  })}>
    <DoxHeader />
    <div class={css({ pt: "32" })}>
      <slot />
    </div>
    <Footer />
  </body>
</html>