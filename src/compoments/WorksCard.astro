---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { flex, vstack } from '../../styled-system/patterns';

interface Props {
  title: string;
  href: string;
  image: ImageMetadata;
  alt_text: string;
  date: string;
  tag: string;
  description: string;
}

const { title, href, image, alt_text, date, tag, description } = Astro.props;
---

<div class={css({m: '4'})}>
  <a href={href}>
    <div class={flex({
      width: '100%',
      height: '160',
      p: '1',
      columnGap: { base: '2', md: '8' },
      border: '1',
      borderColor: 'white',
      borderStyle: 'solid'
    })}>
      <Image
        src={image}
        alt={alt_text}
        class={css({
          width: { base: '20', md: '120' },
          objectFit: 'contain'
        })}
      />
      <div class={vstack({
        alignItems: 'start',
        justify: 'center',
        rowGap: '1'
      })}>
        <p class={css({fontSize: { base: '10', md: '16' } })}>{date}</p>
        <p class={css({fontSize: { base: '14', md: '16' } })}>{title}</p>
        <p class={css({
          fontSize: {base: '9', md: '16' },
          whiteSpace: 'pre-line'
        })}>
          {description}
        </p>
        <p class={css({
          p: '1',
          border: '1',
          borderStyle: 'solid',
          fontSize: {base: '8', md: '12' },
        })}>
          #{tag}
        </p>
      </div>
    </div>
  </a>
</div>