---
import { Image } from 'astro:assets';

import '../styles/global.css';
import { css } from '../../styled-system/css';
import { grid, flex } from '../../styled-system/patterns';

import mizuame_banner from '../assets/banner/mizuame_banner.png';
---

<hr>
<footer class={css({p: '4', fontSize: '16'})}>
  <div class={flex({
    direction: { base: 'column', lg: 'row' },
    align: 'center',
    justify: 'space-between',
    gap: '4'
  })}>
    <p>&copy;2026 AK47 All Rights Reserved.</p>
    <div class={grid({ columns: { base: 2, lg: 4 }, gap: '4', alignItems: 'center' })}>
      <p class={css({textAlign: 'center'})}>相互リンク募集中 →</p>
      <a href="https://www.ak47.work">
        <Image src={'https://www.ak47.work/assets/banner/ak47_banner.png'} width={200} height={40} alt='AK47 の個人サイト' />
      </a>
      <a href="https://ron736382.com">
        <Image src={'https://ron736382.com/archive/202603/img/banner.gif'} width={200} height={40} alt="RONの創作物/編集物保管庫"/>
      </a>
      <a href="https://mizuame.works">
        <Image src={mizuame_banner} alt="みずあめのポートフォリオ" width={200} />
      </a>
    </div>
    <p>Source Code available on <a href="https://github.com/ayamine47/ak47-website"><u>GitHub</u></a>.</p>
  </div>
</footer>